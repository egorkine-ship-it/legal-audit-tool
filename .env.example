# ---------------------------------------------------------------------------
# Переменные окружения веб-версии (production).
# На хостинге (Railway/Render) задавайте их в разделе Variables / Environment.
# Локально: скопируйте в .env и заполните.
# Секреты хранятся ТОЛЬКО в переменных окружения, не в коде.
# ---------------------------------------------------------------------------

# --- Авторизация (обязательно на production) ---
ADMIN_EMAIL=admin@yourbureau.ru
ADMIN_PASSWORD=            # задайте надёжный временный пароль; смените в UI после входа
SESSION_SECRET=            # длинная случайная строка (напр. `openssl rand -hex 32`)

# --- LLM (OpenAI-совместимый API) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
ENABLE_LLM=true

# --- База данных ---
# Postgres для облака (Railway/Render дают DATABASE_URL автоматически).
# Если пусто — используется SQLite в EXPORTS_DIR (нужен persistent volume).
DATABASE_URL=

# --- Хранилище экспортов (PDF) и SQLite ---
EXPORTS_DIR=/data

# --- Параметры сканирования ---
MAX_PAGES_DEFAULT=20
PAGE_TIMEOUT_SECONDS=20
ENABLE_GEOIP=false
ENABLE_SCREENSHOTS=false

# --- Реквизиты юридического бюро (для отчётов, КП и писем) ---
BUREAU_NAME=
BUREAU_EMAIL=
BUREAU_PHONE=
BUREAU_WEBSITE=

# --- Цены услуг (необязательно; можно менять в UI «Настройки») ---
PRICE_EXPRESS_AUDIT=
PRICE_EXPRESS_DOCS=
PRICE_FULL_AUDIT=
PRICE_TURNKEY=
